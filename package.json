{
  "name": "honeylock",
  "version": "0.1.0",
  "description": "A tiny, zero-dependency MCP proxy that blocks tool-call exfiltration and leaves a tamper-evident audit trail.",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=20.11"
  },
  "bin": {
    "honeylock": "dist/src/index.js"
  },
  "files": [
    "dist/src",
    "attacks",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/decode.test.js dist/test/detectors.test.js dist/test/ledger.test.js dist/test/lock.test.js dist/test/proxy.test.js",
    "benchmark": "node dist/src/index.js benchmark",
    "verify": "node dist/src/index.js verify"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "publishConfig": {
    "provenance": true
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "security",
    "proxy",
    "prompt-injection",
    "exfiltration",
    "llm"
  ]
}
